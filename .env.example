# Samma3ni - Environment Variables Example
# Copy to `.env` and fill with local or production values.

SERVER_PORT=8085
SPRING_DATA_MONGODB_URI=mongodb://127.0.0.1:27017/samma3ni

# Security
JWT_SECRET=replace_with_a_256_bit_secret_key
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_in_production

# Optional Integrations
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
MAIL_ENABLED=false
MAIL_USERNAME=
MAIL_PASSWORD=
